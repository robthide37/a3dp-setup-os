def enumerate_payload(cfg):
    serials = label_serials(list_serial_mcus(), parse_mcus_ini(cfg["mcus_ini"]))
    return {
        "bootsel": find_bootsel_volumes(),
        "serial": serials,
        "firmware": scan_firmware_dir(cfg["firmware_dir"]),
        "firmware_dir": cfg["firmware_dir"],
        "versions": klippy_mcu_versions(cfg["klippy_log"]),
        "klipper_running": _klipper_service_active(),
        "katapult_tool": find_katapult_tool(cfg),
    }


def _klipper_service_active():
    try:
        r = subprocess.run(["systemctl", "is-active", "--quiet", "klipper"])
        return r.returncode == 0
    except OSError:
        return False


class Handler(BaseHTTPRequestHandler):
    cfg = None

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            body = PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/boards":
            self._json(enumerate_payload(self.cfg))
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        if self.path != "/api/flash":
            return self._json({"error": "not found"}, 404)
        n = int(self.headers.get("Content-Length", 0))
        try:
            req = json.loads(self.rfile.read(n))
        except json.JSONDecodeError:
            return self._json({"ok": False, "msg": "bad json"}, 400)
        uf2 = req.get("file")
        if not os.path.isfile(uf2):
            # allow a bare filename resolved inside firmware_dir
            alt = os.path.join(self.cfg["firmware_dir"], os.path.basename(str(uf2)))
            if os.path.isfile(alt):
                uf2 = alt
            else:
                return self._json({"ok": False, "msg": f"firmware file not found: {uf2}"})
        before = list_serial_mcus()
        if req.get("kind") == "katapult":
            target = req.get("target") or ""
            kat = {s["name"] for s in list_serial_mcus() if s["kind"] == "katapult"}
            if target not in kat:
                return self._json({"ok": False,
                                   "msg": f"{target} is not a katapult-bootloader board right now"})
            ok, msg = flash_katapult(uf2, os.path.join("/dev/serial/by-id", target),
                                     find_katapult_tool(self.cfg))
        else:
            block_dev = req.get("block_dev")
            bootsel = {b["block_dev"] for b in find_bootsel_volumes()}
            if block_dev not in bootsel:
                return self._json({"ok": False,
                                   "msg": f"{block_dev} is not a BOOTSEL-mode board right now"})
            ok, msg = flash_boot(uf2, block_dev)
        if ok:
            new = wait_reenumerate(before)
            msg += f"; re-enumeration: {new or 'not seen yet (check dmesg)'}"
        self._json({"ok": ok, "msg": msg})

    def log_message(self, fmt, *args):
        sys.stderr.write("[mcu-flashd] " + fmt % args + "\n")


def serve(cfg):
    Handler.cfg = cfg
    httpd = ThreadingHTTPServer((cfg["listen"], cfg["port"]), Handler)
    print(f"a3dp-mcu-flashd serving http://{cfg['listen']}:{cfg['port']} "
          f"(firmware_dir={cfg['firmware_dir']})", flush=True)
    httpd.serve_forever()


# --------------------------------------------------------------------- cli

def cmd_enumerate(cfg, as_json):
    payload = enumerate_payload(cfg)
    if as_json:
        print(json.dumps(payload, indent=2))
        return 0
    for s in payload["serial"]:
        print(f"{s.get('kind', 'other'):7s}  {s['name']}  tty={s['tty']}"
              f"  vid:pid={s['vid:pid']}"
              + (f"  board={s['board']}" if s["board"] else ""))
    for b in payload["bootsel"]:
        print(f"BOOTSEL {b['usb_dev']}  {b['block_dev']}  ({b['label']}) — flashable")
    kats = [s for s in payload["serial"] if s.get("kind") == "katapult"]
    if kats:
        print("katapult flashtool: "
              + (payload.get("katapult_tool")
                 or "NOT FOUND (clone katapult / set katapult_flashtool)"))
    if not payload["serial"] and not payload["bootsel"]:
        print("no MCU boards found")
    print(f"firmware dir: {payload['firmware_dir']} "
          f"({len(payload['firmware'])} .uf2 file(s))")
    return 0


def cmd_flash(cfg, target, uf2):
    kind, obj = resolve_target(target, cfg)
    if kind is None:
        print(f"target '{target}' not found — run enumerate. A board must be in "
              "BOOTSEL mode (hold BOOTSEL while plugging USB) for the "
              "Klipper-independent path.", file=sys.stderr)
        return 2
    if kind == "serial":
        print(f"'{target}' is a running Klipper board ({obj['name']}) — the "
              "Klipper-independent path only flashes BOOTSEL or katapult-"
              "bootloader boards. Use the FLASH_MCU macro / moonraker-mcu-"
              "flasher while klipper works, or hold BOOTSEL (or enter katapult) "
              "and re-run.", file=sys.stderr)
        return 3
    before = list_serial_mcus()
    if kind == "katapult":
        ok, msg = flash_katapult(uf2, os.path.join("/dev/serial/by-id", obj["name"]),
                                 find_katapult_tool(cfg))
        print(msg)
        if not ok:
            return 1
        new = wait_reenumerate(before)
        print(f"re-enumeration: {new or 'not seen within 25s — check dmesg / replug'}")
        return 0
    ok, msg = flash_boot(uf2, obj["block_dev"])
    print(msg)
    if not ok:
        return 1
    new = wait_reenumerate(before)
    print(f"re-enumeration: {new or 'not seen within 25s — check dmesg / replug'}")
    return 0


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--cfg", default="/etc/a3dp-mcu-flashd.ini",
                        help="service ini (default /etc/a3dp-mcu-flashd.ini)")
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                 parents=[common])
    sub = ap.add_subparsers(dest="cmd", required=True)
    # --cfg accepted before AND after the subcommand (systemd unit uses the latter)
    sub.add_parser("enumerate", parents=[common]).add_argument(
        "--json", action="store_true")
    p = sub.add_parser("flash", parents=[common])
    p.add_argument("target", help="board name (mcus.ini), chipid or block dev")
    p.add_argument("uf2", help="firmware .uf2 file")
    sub.add_parser("serve", parents=[common]).add_argument("--port", type=int)
    args = ap.parse_args()
    cfg = load_cfg(args.cfg)
    if args.cmd == "enumerate":
        sys.exit(cmd_enumerate(cfg, args.json))
    if args.cmd == "flash":
        sys.exit(cmd_flash(cfg, args.target, args.uf2))
    if args.port:
        cfg["port"] = args.port
    serve(cfg)


if __name__ == "__main__":
    main()
