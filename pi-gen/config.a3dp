# pi-gen config for the A3DP fleet image.
# Base: Raspberry Pi OS Lite 64-bit (trixie) — boots Pi 4 and Pi 5.
IMG_NAME='a3dp-image'
RELEASE='trixie'
TARGET_ARCH=64

FIRST_USER_NAME='pi'
# FIRST_USER_PASS: generated at build time by build.sh (required by pi-gen
# when DISABLE_FIRST_BOOT_USER_RENAME=1); pi account locked in stage-a3dp-final.
DISABLE_FIRST_BOOT_USER_RENAME=1

STAGE_LIST='stage0 stage1 stage2 stage-a3dp-base stage-a3dp-final'

# No default credentials, no SSH by default: Imager customization injects the
# fleet key + hostname at flash time (README: Flash + activate).
ENABLE_SSH=0

LOCALE_DEFAULT='en_US.UTF-8'
KEYBOARD_KEYMAP='us'
KEYBOARD_LAYOUT='English (US)'
TIMEZONE_DEFAULT='America/New_York'
TARGET_HOSTNAME='a3dp'

DEPLOY_COMPRESSION='xz'
