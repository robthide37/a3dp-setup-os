def load_cfg(path):
    cp = configparser.ConfigParser()
    if path and os.path.isfile(path):
        cp.read(path)
    else:
        cp.read_string(DEFAULT_INI)
    svc = cp["service"] if cp.has_section("service") else {}
    expand = lambda k, d: os.path.expanduser(svc.get(k, d)) if svc else d
    return {
        "listen": svc.get("listen", "127.0.0.1") if svc else "127.0.0.1",
        "port": int(svc.get("port", 7130)) if svc else 7130,
        "firmware_dir": expand("firmware_dir", "~/printer_data/config/firmware"),
        "mcus_ini": expand("mcus_ini", "~/printer_data/config/meter-kit/mcus.ini"),
        "config_dir": expand("config_dir", "~/printer_data/config/flash/config"),
        "klippy_log": expand("klippy_log", "~/printer_data/logs/klippy.log"),
        "katapult_flashtool": expand("katapult_flashtool",
                                     "~/katapult/scripts/flashtool.py"),
        "can_interface": (svc.get("can_interface", "") if svc else "") or "",
        "can_python": expand("can_python", "~/klippy-env/bin/python") or "",
        "canbus_query": expand("canbus_query",
                               "~/klipper/scripts/canbus_query.py") or "",
        "can_query_cmd": (svc.get("can_query_cmd", "") if svc else "") or "",
        "moonraker_url": (svc.get("moonraker_url", "http://127.0.0.1:7125")
                          if svc else "http://127.0.0.1:7125"),
        "klipper_dir": expand("klipper_dir", "~/klipper"),
        "klipper_service": (svc.get("klipper_service", "klipper")
                            if svc else "klipper"),
        "run_home": (svc.get("run_home", "") if svc else "") or None,
    }


