#!/usr/bin/env python3
"""a3dp-mcu-flash — self-contained MCU flasher for A3DP kit units.

Klipper-independent recovery path: flashes rp2040 boards in BOOTSEL mode
(mount / copy UF2 / umount over USB mass storage) with NO klipper, NO
moonraker, NO klippy involved. Complements the klippy FLASH_MCU macro happy
path (moonraker-mcu-flasher), which requires a working print stack.

Subcommands:
  enumerate                  list BOOTSEL + katapult-bootloader + USB-serial MCU boards (JSON)
  flash <board|serial> <uf2> flash a BOOTSEL or katapult-bootloader board from a UF2 file
  verify <board|serial>      check a board's by-id identity against its config.mcu
  full [--plan|--yes]        full update: build every mcus.ini slot from its
                             config.<slot> menuconfig at the running host version
                             and flash it (identity-gated, print-guarded) — the
                             one-button auto-flash trigger surface
  serve [--port N] [--cfg F] run the web UI (default 127.0.0.1:7130)

Deterministic identity: a board's /dev/serial/by-id name is set by its
FIRMWARE (Kconfig USB_MANUFACTURER / USB_SERIAL_NUMBER, or the chip-id when
USB_SERIAL_NUMBER_CHIPID=y). The per-board menuconfig files in flash/config/
(config.<board>, UKAM KCONFIG_CONFIG) are the identity source; this tool
refuses a flash that would rename a board slot away from what config.mcu and
the live fleet say (identity gate), and verifies the post-flash enumeration.

Stdlib only (Python >= 3.9) — safe to drop on a bare Pi OS Lite image.
Board-name mapping comes from the repo's existing A3dp/flash mcus.ini
convention (sections [name] whose command carries a /dev/serial/by-id path).
"""

import argparse
import configparser
import fnmatch
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
# usb ids of interest
VID_RPI = "2e8a"
PID_RP2_BOOT = "0003"      # RP2 ROM bootloader, USB mass storage
VID_KLIPPER = "1d50"
# PID varies (614e for klipper CDC); any 1d50:* serial entry is treated as MCU
PID_KATAPULT = "6177"       # katapult CDC bootloader (Arksine/katapult flashtool.py)

MOUNTPOINT = "/run/a3dp-mcu-flash"
UF2_MAGIC0 = 0x0A324655   # "UF2\n" LE
UF2_MAGIC1 = 0x9E5D5157   # UF2 header magic1 (RP2040 family ID 0xE48BFF56 is a separate field at block offset 28)
# by-id serial tail = everything between the LAST '_' and '-if00'. Works for
# chip-id serials (hex, any length — STM32 96-bit ids are 24 chars, the old
# 8–16-hex pattern silently missed them) AND for deterministic A3DP serials
# ('main', 'head0'), which are not hex at all. Rift 2026-11-13: hex-only
# matching left every deterministic-identity board unlabeled (board: null)
# and made `verify <slot>` unresolvable.
BY_ID_RE = re.compile(r"usb-.*_(.+)-if00")


# ---------------------------------------------------------------- sysfs / sys

def _read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def find_bootsel_volumes(sysfs="/sys"):
    """Return [{'usb_dev', 'block_dev'}] for every rp2040 board in BOOTSEL mode.

    The RP2 ROM bootloader enumerates as VID 2e8a:0003 USB mass storage
    (FAT volume, no partition table). Discovery: match usb devices under
    sysfs by vid/pid, then find the block device whose sysfs realpath sits
    under that usb device directory.
    """
    bus = os.path.join(sysfs, "bus/usb/devices")
    bootsel = []
    if not os.path.isdir(bus):
        return bootsel
    targets = []
    for name in sorted(os.listdir(bus)):
        dev = os.path.join(bus, name)
        if not os.path.isdir(dev) or ":" not in name:
            # skip interface dirs (contain ':') and root hubs
            if ":" in name:
                continue
            if _read(os.path.join(dev, "idVendor")) == VID_RPI and \
               _read(os.path.join(dev, "idProduct")) == PID_RP2_BOOT:
                targets.append(os.path.realpath(dev))
    if not targets:
        return bootsel
    block_dir = os.path.join(sysfs, "block")
    if not os.path.isdir(block_dir):
        return bootsel
    for blk in sorted(os.listdir(block_dir)):
        real = os.path.realpath(os.path.join(block_dir, blk))
        for t in targets:
            if real.startswith(t + os.sep):
                # prefer partition devices (e.g. sda1) over whole-disk (sda):
                # the FAT volume lives on the partition when one exists.
                blk_dir = os.path.join(block_dir, blk)
                try:
                    parts = sorted(d for d in os.listdir(blk_dir)
                                   if d.startswith(blk) and d[-1].isdigit())
                except OSError:
                    parts = []
                for devname in (parts or [blk]):
                    bootsel.append({"usb_dev": os.path.basename(t),
                                    "block_dev": "/dev/" + devname,
                                    "label": _read(os.path.join(real, "label")) or "RPI-RP2"})
    # prefer partition devices (e.g. sda1) over whole-disk (sda) for mount
    if bootsel and any(b["block_dev"][-1].isdigit() for b in bootsel):
        bootsel = [b for b in bootsel if b["block_dev"][-1].isdigit()]
    return bootsel


def classify_serial(name, vidpid=""):
    """kind of a /dev/serial/by-id entry: katapult | klipper | other.
    katapult = board sitting in the katapult bootloader (flashable via
    katapult's flashtool.py); klipper = board running Klipper CDC."""
    low = name.lower()
    if "katapult" in low or vidpid == f"{VID_KLIPPER}:{PID_KATAPULT}":
        return "katapult"
    if "klipper" in low:
        return "klipper"
    return "other"


def list_serial_mcus(by_id_dir="/dev/serial/by-id"):
    """Return [{'name'(by-id filename), 'chipid', 'tty', 'vid:pid', 'kind'}] for
    every USB serial device; chipid extracted from the by-id filename."""
    out = []
    if not os.path.isdir(by_id_dir):
        return out
    for name in sorted(os.listdir(by_id_dir)):
        m = BY_ID_RE.search(name)
        try:
            tty = os.path.basename(os.readlink(os.path.join(by_id_dir, name)))
        except OSError:
            tty = os.path.basename(os.path.realpath(os.path.join(by_id_dir, name)))
        # sysfs anchor: /sys/class/tty/<tty>/device = the USB interface dir;
        # its parent is the usb device dir carrying idVendor/idProduct.
        vidpid = ""
        cur = os.path.realpath(os.path.join("/sys/class/tty", tty, "device"))
        for _ in range(4):
            cur = os.path.dirname(cur)
            v = _read(os.path.join(cur, "idVendor"))
            if v:
                vidpid = f"{v}:{_read(os.path.join(cur, 'idProduct'))}"
                break
        out.append({"name": name, "chipid": m.group(1) if m else None,
                    "tty": tty, "vid:pid": vidpid,
                    "kind": classify_serial(name, vidpid)})
    return out


# ------------------------------------------------------------------ mcus.ini

def parse_mcus_ini(path):
    """{board_name: chipid-or-serial-tail} from A3dp/flash mcus.ini sections.
    Accepts action_command/flash_cmd lines carrying /dev/serial/by-id paths."""
    boards = {}
    if not path or not os.path.isfile(path):
        return boards
    cp = configparser.ConfigParser(strict=False)
    cp.read(path)
    for sec in cp.sections():
        for _, val in cp.items(sec):
            m = re.search(r"/dev/serial/by-id/(\S+)", val)
            if m:
                mm = BY_ID_RE.search(m.group(1))
                boards[sec] = mm.group(1) if mm else m.group(1)
                break
    return boards


def label_serials(serials, boards):
    """Attach board names from the mcus.ini chipid map to serial entries."""
    rev = {v: k for k, v in boards.items()}
    for s in serials:
        s["board"] = rev.get(s["chipid"])
    return serials


# --------------------------------------------------------------------- uf2

def validate_uf2(path):
    """Cheap structural check: first 512-byte block carries the UF2 magics.
    Prevents flashing a .bin/.elf renamed .uf2."""
    try:
        with open(path, "rb") as f:
            hdr = f.read(512)
    except OSError as e:
        return False, f"unreadable: {e}"
    if len(hdr) < 512:
        return False, "file smaller than one UF2 block"
    m0, m1 = struct.unpack_from("<II", hdr, 0)
    if m0 != UF2_MAGIC0 or m1 != UF2_MAGIC1:
        return False, "missing UF2 block magic — is this really a .uf2?"
    return True, "ok"


def scan_firmware_dir(fw_dir):
    """All *.uf2 under fw_dir (recursive), as [{'path', 'board', 'file'}].
    Board = leading token before '-' or '_' (e.g. rp2040main-v1.2.uf2)."""
    out = []
    if not fw_dir or not os.path.isdir(fw_dir):
        return out
    for root, _, files in os.walk(fw_dir):
        for fn in sorted(files):
            if not fn.lower().endswith(".uf2"):
                continue
            board = re.split(r"[-_]", fn, maxsplit=1)[0].lower()
            out.append({"path": os.path.join(root, fn), "file": fn, "board": board})
    return out


def firmware_for_board(fw_dir, board):
    return [f for f in scan_firmware_dir(fw_dir)
            if f["board"] == board.lower()
            or fnmatch.fnmatch(os.path.basename(f["file"]).lower(), board.lower() + "*.uf2")]


# ------------------------------------------------------------------- flash

def _run(cmd, **kw):
    """subprocess.run wrapper; adds sudo when not root and cmd needs it."""
    if os.geteuid() != 0 and cmd[0] in ("mount", "umount"):
        cmd = ["sudo"] + cmd
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def flash_boot(uf2_path, block_dev, mountpoint=MOUNTPOINT):
    """Mount a BOOTSEL-mode board's FAT volume, write the UF2, unmount.
    Does NOT wait for re-enumeration (see wait_reenumerate) — separate so the
    sequence is testable against a loop-mounted FAT image."""
    ok, why = validate_uf2(uf2_path)
    if not ok:
        return False, f"UF2 check failed: {why}"
    os.makedirs(mountpoint, exist_ok=True)
    r = _run(["mount", "-t", "vfat", "-o", "shortname=mixed,uid=0,gid=0",
              block_dev, mountpoint])
    if r.returncode != 0:
        return False, f"mount {block_dev} failed: {r.stderr.strip()}"
    try:
        dest = os.path.join(mountpoint, "firmware.uf2")
        shutil.copyfile(uf2_path, dest)
        with open(dest, "rb") as f:
            os.fsync(f.fileno())
        subprocess.run(["sync"], check=False)
        # RP2 bootloader ejects itself after the write; umount may race it.
        r = _run(["umount", mountpoint])
        if r.returncode != 0 and "not mounted" not in r.stderr:
            time.sleep(1.0)
            r = _run(["umount", mountpoint])
            if r.returncode != 0 and "not mounted" not in r.stderr:
                return False, f"umount failed: {r.stderr.strip()}"
    finally:
        if os.path.ismount(mountpoint):
            _run(["umount", "-f", mountpoint])
    return True, f"flashed {os.path.basename(uf2_path)} -> {block_dev} (board reboots on its own)"


def wait_reenumerate(before_serials, timeout=25):
    """Wait until the flashed board comes back after the bootloader dance.
    Returns the by-id names that appeared. Two success shapes:
    - a renamed/chip-id board shows up as a NEW name;
    - a deterministic (flash-time identity) board drops off USB and returns
      under its SAME name — Rift f446 2026-11-13: the old new-names-only
      logic reported 're-enumerated nothing' for a flash that succeeded.
    Returns None when the board never left-and-returned within timeout."""
    deadline = time.time() + timeout
    old = {s["name"] for s in before_serials}
    left = False
    while time.time() < deadline:
        time.sleep(1.0)
        now = {s["name"] for s in list_serial_mcus()}
        if now - old:
            return sorted(now - old)
        if old - now:
            left = True                    # board dropped off USB
        elif left:
            return sorted(old & now)       # returned under the same name
    return None


# ---------------------------------------------------------------- katapult

def find_katapult_tool(cfg):
    """Path to katapult's flashtool.py (cfg key katapult_flashtool), or None."""
    tool = os.path.expanduser(cfg.get("katapult_flashtool")
                              or "~/katapult/scripts/flashtool.py")
    return tool if os.path.isfile(tool) else None


def _pyserial_ok(python="python3"):
    """katapult flashtool.py imports 'serial' (pyserial) for USB serial boards."""
    try:
        r = subprocess.run([python, "-c", "import serial"], capture_output=True)
    except OSError:
        return False
    return r.returncode == 0


def flash_katapult(uf2_path, device, tool, timeout=120, run=None):
    """Flash a board sitting in the katapult bootloader (USB CDC serial).
    katapult flashtool.py CLI (Arksine/katapult): flashtool.py -d <dev> -f <fw>.
    The board re-enumerates as klipper CDC once the write completes."""
    run = run or _run
    if not tool or not os.path.isfile(tool):
        return False, ("katapult flashtool.py not found — clone katapult "
                       "(git clone https://github.com/Arksine/katapult "
                       "~/katapult) or set katapult_flashtool in the ini")
    ok, why = validate_uf2(uf2_path)
    if not ok:
        return False, f"UF2 check failed: {why}"
    if not _pyserial_ok():
        return False, ("pyserial missing for python3 — "
                       "sudo apt install python3-serial (flashtool needs it)")
    r = run(["python3", tool, "-d", device, "-f", uf2_path], timeout=timeout)
    tail = ((r.stdout or "") + (r.stderr or "")).strip()[-400:]
    if getattr(r, "returncode", 1) != 0:
        return False, f"flashtool failed (rc={r.returncode}): {tail}"
    return True, f"flashtool OK on {device}: {tail or 'Programming Complete'}"


def resolve_target(target, cfg, sysfs="/sys", by_id_dir="/dev/serial/by-id"):
    """Map a user-supplied board name or by-id fragment to either a BOOTSEL
    block device or a running CDC board entry."""
    bootsel = find_bootsel_volumes(sysfs=sysfs)
    serials = label_serials(list_serial_mcus(by_id_dir=by_id_dir),
                            parse_mcus_ini(cfg.get("mcus_ini")))
    # config-driven fallback: the slot name itself resolves when its
    # config.<slot> yields the by-id the board is enumerated under (works
    # even when mcus.ini is missing/unfinished — deterministic-serial boards)
    cfg_expected = None
    if target and cfg.get("config_dir"):
        cfg_expected = expected_byid(
            parse_kconfig_identity(config_file_for(target, cfg)))
    for b in bootsel:
        if target in (b["usb_dev"], b["block_dev"]) or target == "bootsel":
            return ("bootsel", b)
    for s in serials:
        if s["kind"] == "katapult" and (
                target == "katapult"
                or target in s["name"]
                or (s["chipid"] and s["chipid"].lower() == target.lower())
                or (s.get("board") or "").lower() == target.lower()):
            return ("katapult", s)
    for s in serials:
        if s["chipid"] and (s["chipid"].lower() == target.lower()
                            or (s.get("board") or "").lower() == target.lower()
                            or target in s["name"]):
            return ("serial", s)
        if cfg_expected and s["name"] == cfg_expected:
            return ("serial", s)
    return (None, None)


# ------------------------------------------------------------------ version

def klippy_mcu_versions(log_path):
    """{'rp2040main': 'v0.12.0-317-gb89d5523', ...} parsed from klippy.log
    ('mcu <name> version: ...'). Best-effort; empty when klippy never ran."""
    versions = {}
    if not log_path or not os.path.isfile(log_path):
        return versions
    pats = [
        # Kalico: "Loaded MCU 'mcu' 118 commands (Klipper v0.12.0-317-gb89d5523 / gcc: ...)"
        re.compile(r"Loaded MCU '([^']+)' .*\((?:Klipper|Kalico) (v[0-9][^)\s]*|\?[^)\s]*|unknown)"),
        # "MCU 'mcu' currently has firmware compiled for Klipper (version v0.12.0-...)."
        re.compile(r"MCU '([^']+)' currently has firmware compiled for \S+ \(version (v[0-9][^)\s]*|\?[^)\s]*|unknown)"),
        # upstream style: "mcu 'mcu' version: v0.12.0-..."
        re.compile(r"mcu '([^']+)' (?:version|is version)[:]?\s*(v[0-9][^)\s]*|\?[^)\s]*|unknown)"),
    ]
    try:
        with open(log_path, errors="replace") as f:
            for line in f:
                for p in pats:
                    m = p.search(line)
                    if m:
                        versions[m.group(1)] = m.group(2)
                        break
    except OSError:
        pass
    return versions


# ------------------------------------------------- deterministic identity

def parse_kconfig_identity(path):
    """USB identity a firmware build carries, from its menuconfig file
    (flash/config/config.<board> — UKAM's KCONFIG_CONFIG=... per-MCU config).

    Klipper/Kalico Kconfig (src/Kconfig): CONFIG_USB_SERIAL_NUMBER_CHIPID
    defaults y — the USB serial is the chip's UNIQUE id, so every physical
    board enumerates differently and a replacement needs a config edit.
    Clearing it and setting CONFIG_USB_SERIAL_NUMBER="<role>" (plus
    CONFIG_USB_MANUFACTURER) bakes a fixed identity into the firmware: every
    board flashed with that build enumerates as the same
    /dev/serial/by-id/usb-<manufacturer>_<product>_<serial>-if00 name.
    Returns None when the file is missing."""
    if not path or not os.path.isfile(path):
        return None
    kv = {}
    try:
        with open(path, errors="replace") as f:
            for line in f:
                line = line.strip()
                m = re.match(r'^(CONFIG_[A-Z0-9_]+)=(.*)$', line)
                if m:
                    kv[m.group(1)] = m.group(2).strip('"')
                    continue
                m = re.match(r'^# CONFIG_([A-Z0-9_]+) is not set$', line)
                if m:
                    kv["unset:" + m.group(1)] = True
    except OSError:
        return None
    chipid = "unset:USB_SERIAL_NUMBER_CHIPID" not in kv
    mcu = kv.get("CONFIG_MCU")
    product = kv.get("CONFIG_USB_PRODUCT")
    if not product and kv.get("CONFIG_USB_PRODUCT_FROM_MCU", "y") != "n":
        product = mcu
    return {
        "mcu": mcu,
        "manufacturer": kv.get("CONFIG_USB_MANUFACTURER") or "Klipper",
        "product": product,
        "serial": kv.get("CONFIG_USB_SERIAL_NUMBER") if not chipid else None,
        "chipid": chipid,
        "vid": kv.get("CONFIG_USB_VENDOR_ID"),
        "pid": kv.get("CONFIG_USB_DEVICE_ID"),
    }


def config_file_for(board, cfg):
    """flash/config/config.<board> — UKAM names each per-MCU menuconfig after
    its mcus.ini section (KCONFIG_CONFIG=config/$mcu)."""
    if not board:
        return None
    return os.path.join(cfg.get("config_dir") or "", "config." + board)


def expected_byid(ident):
    """The /dev/serial/by-id filename a build with this identity produces
    (systemd usb_id naming: usb-<manufacturer>_<product>_<serial>-if00).
    None when the build uses chip-id serials (identity not deterministic)."""
    if not ident or ident["chipid"] or not ident["serial"] or not ident["product"]:
        return None
    return "usb-{}_{}_{}-if00".format(
        ident["manufacturer"], ident["product"], ident["serial"])


def live_flash_fallback(expected, ident, serials, other_expected=()):
    """Live stock-fw by-id to flash THROUGH when the slot's expected
    deterministic name is not enumerated (board still running stock firmware —
    the expected name only exists AFTER the flash; Rift 2026-11-13:
    `make flash FLASH_DEVICE=<expected>` died with `Unable to find tty device`
    for both slots, and the manual fix was to target the CURRENT stock by-id).

    Candidates: live serials not claimed by any slot's expected name. A name
    containing the config's CONFIG_MCU token wins (stock klipper firmware
    enumerates as usb-Klipper_stm32f446xx_<chipid>-if00 — same product token);
    otherwise the candidate pool must be exactly one. Returns the by-id
    filename, or None when no unique candidate exists."""
    if not expected or not ident:
        return None
    taken = set(other_expected or ()) | {expected}
    cands = [s["name"] for s in (serials or []) if s["name"] not in taken]
    mcu = ident.get("mcu")
    chip = [n for n in cands if mcu and mcu.lower() in n.lower()]
    pool = chip or cands
    return pool[0] if len(pool) == 1 else None


def identity_gate(board, cfg, serials=None, allow_change=False):
    """Pre-flash identity reconciliation for a board slot.

    Returns (status, msg); status is 'ok' (proceed), 'warn' (proceed with a
    notice), 'refuse' (do NOT flash) or 'unknown' (no config.mcu to check).

    Refusal case: config.mcu expects a fixed by-id name but a live board of
    the same product reports a different serial — config.mcu has drifted from
    the fleet (real case, Rift 2026-11-12: config.mcu said 'a3dpmain' while
    the flashed main board reports 'main'); flashing it would rename the slot
    and break printer.cfg. allow_change overrides for deliberate renames."""
    path = config_file_for(board, cfg)
    ident = parse_kconfig_identity(path)
    if ident is None:
        return "unknown", (f"no config.mcu for board '{board}' (looked for "
                           f"{path}) — flashing without an identity check")
    if ident["chipid"]:
        return "warn", ("config.mcu uses chip-id USB serials "
                        "(CONFIG_USB_SERIAL_NUMBER_CHIPID=y): a replacement "
                        "board enumerates under a NEW chip-id — update "
                        "printer.cfg + mcus.ini after the swap")
    expected = expected_byid(ident)
    if expected is None:
        return "unknown", (f"config.mcu for '{board}' has no computable by-id "
                           "name (USB_PRODUCT_FROM_MCU=n without "
                           "CONFIG_USB_PRODUCT?) — cannot check identity")
    live = [s["name"] for s in (serials or [])]
    if expected in live:
        return "ok", f"identity matches live enumeration: {expected}"
    pat = re.compile(r"usb-[^_]+_" + re.escape(ident["product"]) + r"_([^-]+)-if00")
    drift = [n for n in live if pat.match(n)]
    if drift and not allow_change:
        return "refuse", (
            f"identity conflict: config.mcu for '{board}' expects {expected} "
            f"but live {ident['product']} board(s) report {', '.join(drift)}. "
            "config.mcu has drifted from the fleet — fix CONFIG_USB_SERIAL_NUMBER/"
            "CONFIG_USB_MANUFACTURER in config.mcu, or pass "
            "--allow-identity-change to flash the new identity deliberately "
            "(printer.cfg + mcus.ini must be updated afterwards)")
    if not drift:
        return "ok", (f"expected {expected} not enumerated right now "
                      "(board dead or blank) — will verify post-flash")
    return "ok", (f"identity change allowed by override: flashing {expected} "
                  "(update printer.cfg + mcus.ini afterwards)")


def check_post_flash_identity(new_names, expected):
    """Post-flash verdict: the board must re-enumerate as the config.mcu name.
    Returns None when there is no fixed identity to check."""
    if not expected:
        return None
    if new_names and expected in new_names:
        return f"identity verified: {expected} is up"
    return (f"IDENTITY MISMATCH: expected {expected} after flash; "
            f"re-enumerated {new_names or 'nothing'} — wrong firmware/config "
            "for this slot?")

# --------------------------------------------------------------- full update

# Per-slot build/flash timeouts (seconds); a Pi-class host builds klipper in
# ~1-3 min per config, `make flash` adds the bootloader-request dance.
BUILD_TIMEOUT = 1200
FLASH_TIMEOUT = 900
PLACEHOLDER_RE = re.compile(r"<[A-Z][A-Z0-9_]*>")
ACTIVE_PRINT_STATES = ("printing", "paused")


def parse_print_state(body):
    """print_stats.state out of a Moonraker /printer/objects/query body."""
    try:
        d = json.loads(body)
        return d["result"]["status"]["print_stats"].get("state", "")
    except (ValueError, KeyError, TypeError):
        return ""


def moonraker_print_state(url, timeout=4):
    """(reachable, state) from Moonraker print_stats.

    print_stats is a KLIPPY object: with klippy down Moonraker answers with an
    error (HTTPError → caught) and this returns (False, "") — the caller then
    falls back to the klipper-service check. That is correct: klippy down
    means nothing is printing."""
    try:
        with urllib.request.urlopen(url + "/printer/objects/query?print_stats",
                                    timeout=timeout) as r:
            return True, parse_print_state(r.read().decode())
    except Exception:
        return False, ""


def host_klipper_version(klipper_dir):
    """git describe of the host klipper source tree (the build target).
    -c safe.directory=* : the service runs as root while the repo belongs to
    the printer user — without it git refuses ('dubious ownership') and the
    up-to-date detection would silently disable under systemd."""
    try:
        r = subprocess.run(["git", "-C", klipper_dir, "-c", "safe.directory=*",
                            "describe", "--tags", "--always", "--long",
                            "--dirty"],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() or None


def mcus_ini_sections(path):
    """Ordered {slot: {'action': joined action_command}} from mcus.ini.
    quiet_command/flash_command steps are intentionally ignored: full-flash
    runs the action_command (the step that actually writes firmware)."""
    out = {}
    if not path or not os.path.isfile(path):
        return out
    cp = configparser.ConfigParser(strict=False)
    cp.read(path)
    for sec in cp.sections():
        actions = [v.strip() for k, v in cp.items(sec)
                   if k == "action_command" and v.strip()]
        out[sec] = {"action": "; ".join(actions)}
    return out


def action_home(cfg):
    """Home dir for rewriting `~/` inside mcus.ini action strings (the service
    runs as root where ~ would expand to /root). Derived from klipper_dir
    (/home/pi/klipper → /home/pi) unless run_home overrides it in the ini."""
    home = cfg.get("run_home")
    if home:
        return home
    kd = cfg.get("klipper_dir") or ""
    if kd.startswith("/home/"):
        return "/home/" + kd[len("/home/"):].split("/")[0]
    return None


def slot_plan(slot, cfg, serials, allow_change=False, other_expected=None):
    """Decision for one mcus.ini slot: what full-flash would do, and why.

    Command authority (t_c27a88cc decision): config.<slot> is the identity
    source. When it yields a deterministic by-id, the flash targets THAT name
    (mcus.ini action_commands on some machines are unfinished templates).
    Chip-id-mode slots (expected_byid None) fall back to the slot's
    action_command, which must carry a concrete /dev/serial/by-id device.
    Slots with no config.<slot> are skipped with an actionable reason — the
    gate degrades, it never hard-fails the whole run.

    Stock-fw fallback: when the expected name is NOT enumerated live (board
    still running stock firmware — the expected name only exists after the
    flash) and the identity gate passed, FLASH_DEVICE falls back to the
    board's current live by-id (`live_flash_fallback`); the identity is
    assigned by the firmware being flashed and verified post-flash. When the
    gate refused (same-product drift) only --allow-identity-change lets the
    plan through, so the fallback is inherently gated."""
    p = {"slot": slot, "status": "skip", "reason": "", "cmd": None,
         "expected": None, "cfgfile": config_file_for(slot, cfg),
         "gate": "unknown", "gate_msg": ""}
    ident = parse_kconfig_identity(p["cfgfile"])
    if ident is None:
        p["gate"], p["gate_msg"] = "unknown", (
            f"no config.{slot} menuconfig — cannot build correct firmware; "
            "create it per the deterministic-flash procedure (§4)")
        p["reason"] = p["gate_msg"]
        return p
    status, gmsg = identity_gate(slot, cfg, serials, allow_change)
    p["gate"], p["gate_msg"] = status, gmsg
    if status == "refuse":
        p["reason"] = gmsg
        return p
    expected = expected_byid(ident)
    if expected:
        p["build"] = True
        p["expected"] = expected
        flash_dev = expected
        if expected not in {s["name"] for s in (serials or [])}:
            fb = live_flash_fallback(expected, ident, serials,
                                     other_expected=other_expected)
            if fb:
                flash_dev = fb
                p["flash_via_live_name"] = fb
                p["gate_msg"] += (f" — expected {expected} is not enumerated "
                                  f"(stock firmware): flashing via the live "
                                  f"name {fb}, identity assigned post-flash")
            else:
                p["gate_msg"] += (f" — note: expected {expected} is not "
                                  "enumerated and no unique live stock "
                                  "candidate exists; make flash will fail "
                                  "unless the board is flashed manually first")
        p["cmd"] = ["make", "flash", f"KCONFIG_CONFIG={p['cfgfile']}",
                    f"FLASH_DEVICE=/dev/serial/by-id/{flash_dev}"]
        p["status"] = "ready"
        return p
    action = mcus_ini_sections(cfg["mcus_ini"]).get(slot, {}).get("action", "")
    if not action:
        p["reason"] = (f"config.{slot} is chip-id mode and mcus.ini [{slot}] "
                       "has no action_command — no flash target")
        return p
    home = action_home(cfg)
    if home:
        action = action.replace("~/", home + "/")
    ph = PLACEHOLDER_RE.search(action)
    if ph:
        p["reason"] = (f"mcus.ini [{slot}] action_command is an unfinished "
                       f"template ({ph.group(0)}) — fix mcus.ini first")
        return p
    m = re.search(r"/dev/serial/by-id/(\S+)", action)
    if not m:
        p["reason"] = (f"mcus.ini [{slot}] action_command carries no "
                       "/dev/serial/by-id device — refusing to flash blind")
        return p
    p["build"] = True
    p["expected"] = m.group(1)          # post-flash check target (chip-id name)
    if "make flash" in action:
        action = action.replace("make flash",
                                f"make flash KCONFIG_CONFIG={p['cfgfile']}")
        p["cmd"] = ["bash", "-c", action]
    else:
        # non-make flashers (katapult flashtool …) get no KCONFIG_CONFIG —
        # the UF2/bin they consume must have been built from config.<slot>
        p["cmd"] = ["bash", "-c", action]
    p["status"] = "ready"
    return p


def build_full_plan(cfg, slots=None, allow_change=False,
                    service_active=None, print_probe=None):
    """Guard + per-slot plan for the full update. Pure when probes are
    injected (service_active / print_probe) — that is what tests use."""
    if service_active is None:
        service_active = _klipper_service_active()
    reachable, state = (print_probe() if print_probe else
                        moonraker_print_state(cfg["moonraker_url"]))
    if reachable:
        if state in ACTIVE_PRINT_STATES:
            guard = {"ok": False, "reason":
                     f"a print is in progress (print_stats.state={state}) — "
                     "never flash a board mid-print"}
        else:
            guard = {"ok": True, "reason":
                     f"no active print (print_stats.state={state})"}
    elif service_active:
        guard = {"ok": False, "reason":
                 "Moonraker unreachable while the klipper service is active — "
                 "print state cannot be verified; stop klipper or restore "
                 "Moonraker first"}
    else:
        guard = {"ok": True, "reason":
                 "klipper service inactive — nothing can be printing"}
    hostver = host_klipper_version(cfg["klipper_dir"])
    versions = klippy_mcu_versions(cfg["klippy_log"])
    serials = list_serial_mcus()
    sections = mcus_ini_sections(cfg["mcus_ini"])
    # every slot's expected deterministic by-id — the stock-fw fallback must
    # not pick another slot's board as its flash device
    expected_names = set()
    for slot in sections:
        e = expected_byid(parse_kconfig_identity(config_file_for(slot, cfg)))
        if e:
            expected_names.add(e)
    items = []
    for slot in sections:
        if slots and slot not in slots:
            continue
        item = slot_plan(slot, cfg, serials, allow_change,
                         other_expected=expected_names)
        item["current"] = versions.get(slot)
        # per-slot compare: a slot is up to date only when ITS klippy MCU
        # reports the host build version. The old set-level compare ("host
        # version appears among the MCU versions") marked every slot up to
        # date once ONE MCU was current — Rift 2026-11-13: head0 flashed,
        # mcu (f446) still on v2026.03, plan reported mcu up_to_date=True
        # and the full update would have skipped it forever. A slot whose
        # klippy name differs from the mcus.ini name reads as not-up-to-date
        # and gets a (safe, identity-gated) re-flash instead of a skip.
        item["up_to_date"] = bool(hostver) and versions.get(slot) == hostver
        items.append(item)
    return {"guard": guard, "host_version": hostver,
            "mcu_versions": versions, "slots": items}


def _sysctl(action, service):
    cmd = ["systemctl", action, service]
    if os.geteuid() != 0:
        cmd = ["sudo"] + cmd
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except OSError as e:                    # no systemctl/sudo on this host
        return subprocess.CompletedProcess(cmd, 127, "", str(e))


def execute_full(cfg, items, force=False, skip_build=False, log=print):
    """Run the planned full update: guard → stop klipper → per-slot
    (build → flash → verify) → restart klipper. Returns a summary dict."""
    steps = []
    results = []

    def step(msg):
        steps.append({"t": time.strftime("%H:%M:%S"), "msg": msg})
        log(msg)

    reachable, state = moonraker_print_state(cfg["moonraker_url"])
    if reachable and state in ACTIVE_PRINT_STATES:
        step(f"REFUSED: a print is in progress (print_stats.state={state})")
        return {"steps": steps, "results": results, "ok": False,
                "refused": "print_active"}
    was_active = _klipper_service_active()
    if was_active:
        # printer review re-check: close the ~1s residual window between the
        # guard above and the service stop — a print started in that exact
        # second would be killed by the stop. Re-check immediately before.
        reachable, state = moonraker_print_state(cfg["moonraker_url"])
        if reachable and state in ACTIVE_PRINT_STATES:
            step(f"REFUSED: print started between guard and service stop "
                 f"(print_stats.state={state}) — {cfg['klipper_service']} left running")
            return {"steps": steps, "results": results, "ok": False,
                    "refused": "print_active"}
        step(f"stopping {cfg['klipper_service']} service (serial ports must "
             "be free for the bootloader request)")
        r = _sysctl("stop", cfg["klipper_service"])
        if r.returncode != 0:
            step(f"FAILED to stop {cfg['klipper_service']}: "
                 f"{(r.stderr or r.stdout).strip()} — aborting (service "
                 "left as-was: still stopping)")
            return {"steps": steps, "results": results, "ok": False}
    try:
        for item in items:
            if item["status"] != "ready":
                continue
            slot = item["slot"]
            if item["up_to_date"] and not force:
                step(f"[{slot}] skip: firmware matches the host build — "
                     "pass --force to reflash anyway")
                results.append({"slot": slot, "ok": True, "skipped": True,
                                "msg": "up to date"})
                continue
            if item["gate"] == "warn":
                step(f"[{slot}] note: {item['gate_msg']}")
            slot_ok = True
            if item["build"] and not skip_build:
                # Cross-config object isolation: `make clean KCONFIG_CONFIG=<abs>`
                # does NOT fully clean other configs' objects — sequential
                # dual-slot builds (f446 then g0b1) left mixed out/ artifacts
                # and a later f446 rebuild died with `fatal error: stm32g0xx.h`
                # (Rift 2026-11-13). Wipe out/ before EVERY slot build.
                out_dir = os.path.join(cfg["klipper_dir"], "out")
                step(f"[{slot}] wiping {out_dir} (cross-config object isolation)")
                shutil.rmtree(out_dir, ignore_errors=True)
                step(f"[{slot}] building with {item['cfgfile']}")
                for cmd in (["make", "clean", f"KCONFIG_CONFIG={item['cfgfile']}"],
                            ["make", "-j", str(os.cpu_count() or 2),
                             f"KCONFIG_CONFIG={item['cfgfile']}"]):
                    try:
                        r = subprocess.run(cmd, cwd=cfg["klipper_dir"],
                                           capture_output=True, text=True,
                                           timeout=BUILD_TIMEOUT)
                    except subprocess.TimeoutExpired:
                        r = None
                        step(f"[{slot}] BUILD TIMEOUT: {' '.join(cmd[:2])}")
                    if r is None or r.returncode != 0:
                        tail = ((r.stderr or "") + (r.stdout or "")
                                ).strip()[-500:] if r else ""
                        step(f"[{slot}] BUILD FAILED: {tail}")
                        results.append({"slot": slot, "ok": False,
                                        "msg": "build failed"})
                        slot_ok = False
                        break
            if not slot_ok:
                continue
            step(f"[{slot}] flashing: {' '.join(item['cmd'])}")
            if item.get("flash_via_live_name"):
                step(f"[{slot}] note: target is the board's CURRENT live name "
                     f"({item['flash_via_live_name']}) — the board still runs "
                     "stock firmware; it re-enumerates under the assigned "
                     "identity after the flash")
            before = list_serial_mcus()
            try:
                r = subprocess.run(item["cmd"], cwd=cfg["klipper_dir"],
                                   capture_output=True, text=True,
                                   timeout=FLASH_TIMEOUT)
            except subprocess.TimeoutExpired:
                step(f"[{slot}] FLASH TIMEOUT after {FLASH_TIMEOUT}s")
                results.append({"slot": slot, "ok": False,
                                "msg": "flash timed out"})
                continue
            tail = ((r.stdout or "") + (r.stderr or "")).strip()[-500:]
            # dfu-util 0.11 exits rc=2 ("Error during download get_status")
            # AFTER a fully successful download when the board resets on the
            # leave request — ROM DFU + STM32 G0B1, live-proven 2026-11-13:
            # erase+download completed, board re-enumerated running the new
            # firmware. The re-enumeration/identity check is the authority,
            # so a nonzero flasher rc falls through to it instead of failing
            # the slot outright.
            rc_ok = r.returncode == 0
            new = wait_reenumerate(before, timeout=30)
            check = check_post_flash_identity(new, item["expected"])
            identity_ok = bool(check) and check.startswith("identity verified")
            if not identity_ok and item["expected"]:
                # make flash can run the whole bootloader dance (board leaves
                # and returns under its expected name) before
                # wait_reenumerate samples — Rift 2026-11-13: the f446's
                # katapult roundtrip finished inside the make window and the
                # G0B1's DFU leave re-enumerates at make's end. The expected
                # name being up after the flasher ran is the success signal;
                # absent or renamed boards still fail below.
                if item["expected"] in {s["name"] for s in list_serial_mcus()}:
                    check = f"identity verified: {item['expected']} is up"
                    identity_ok = True
            if rc_ok or identity_ok:
                if not rc_ok:
                    step(f"[{slot}] note: flasher rc={r.returncode} after the "
                         "leave request (dfu-util leave-phase poll); identity "
                         "check decides")
                step(f"[{slot}] flash OK; {check or 're-enumerated: ' + str(new)}")
            else:
                step(f"[{slot}] FLASH FAILED (rc={r.returncode}): {tail}")
                results.append({"slot": slot, "ok": False, "msg": tail})
                continue
            results.append({"slot": slot,
                            "ok": not (check and "MISMATCH" in check),
                            "msg": check or tail})
    finally:
        step(f"starting {cfg['klipper_service']} service")
        r = _sysctl("start", cfg["klipper_service"])
        if r.returncode != 0:
            step(f"WARNING: could not start {cfg['klipper_service']}: "
                 f"{(r.stderr or r.stdout).strip()}")
    ok = bool(results) and all(r["ok"] for r in results)
    return {"steps": steps, "results": results, "ok": ok}


# background job state for serve (one full-flash at a time)
FULL_JOB = {"running": False, "done": True, "steps": [], "results": None,
            "summary": None, "started": None, "error": None}
FULL_LOCK = threading.Lock()


def _full_job_log(msg):
    with FULL_LOCK:
        FULL_JOB["steps"].append({"t": time.strftime("%H:%M:%S"), "msg": msg})


def start_full_job(cfg, items, force=False, skip_build=False):
    with FULL_LOCK:
        if FULL_JOB["running"]:
            return False
        FULL_JOB.update({"running": True, "done": False, "steps": [],
                         "results": None, "summary": None, "error": None,
                         "started": time.strftime("%Y-%m-%d %H:%M:%S")})

    def work():
        try:
            summary = execute_full(cfg, items, force=force,
                                   skip_build=skip_build, log=_full_job_log)
            with FULL_LOCK:
                FULL_JOB["summary"] = summary
        except Exception as e:          # never leave the job stuck "running"
            with FULL_LOCK:
                FULL_JOB["error"] = f"{type(e).__name__}: {e}"
        finally:
            with FULL_LOCK:
                FULL_JOB["running"] = False
                FULL_JOB["done"] = True
    threading.Thread(target=work, daemon=True, name="full-flash").start()
    return True

# ----------------------------------------------------------------- config

DEFAULT_INI = """
[service]
listen = 127.0.0.1
port = 7130
firmware_dir = ~/printer_data/config/firmware
mcus_ini = ~/printer_data/config/meter-kit/mcus.ini
config_dir = ~/printer_data/config/flash/config
klippy_log = ~/printer_data/logs/klippy.log
# katapult bootloader flashtool (used when a board enumerates as usb-katapult_*)
katapult_flashtool = ~/katapult/scripts/flashtool.py
# full-update targets
moonraker_url = http://127.0.0.1:7125
klipper_dir = ~/klipper
klipper_service = klipper
# home used to rewrite ~/ inside mcus.ini action_commands (service runs as
# root); derived from klipper_dir when empty
run_home =
"""


def load_cfg(path):
    cp = configparser.ConfigParser()
    if path and os.path.isfile(path):
        cp.read(path)
    else:
        cp.read_string(DEFAULT_INI)
    svc = cp["service"] if cp.has_section("service") else {}
    expand = lambda k, d: os.path.expanduser(svc.get(k, d)) if svc else d
    return {
        "listen": svc.get("listen", "127.0.0.1") if svc else "127.0.0.1",
        "port": int(svc.get("port", 7130)) if svc else 7130,
        "firmware_dir": expand("firmware_dir", "~/printer_data/config/firmware"),
        "mcus_ini": expand("mcus_ini", "~/printer_data/config/meter-kit/mcus.ini"),
        "config_dir": expand("config_dir", "~/printer_data/config/flash/config"),
        "klippy_log": expand("klippy_log", "~/printer_data/logs/klippy.log"),
        "katapult_flashtool": expand("katapult_flashtool",
                                     "~/katapult/scripts/flashtool.py"),
        "moonraker_url": (svc.get("moonraker_url", "http://127.0.0.1:7125")
                          if svc else "http://127.0.0.1:7125"),
        "klipper_dir": expand("klipper_dir", "~/klipper"),
        "klipper_service": (svc.get("klipper_service", "klipper")
                            if svc else "klipper"),
        "run_home": (svc.get("run_home", "") if svc else "") or None,
    }


