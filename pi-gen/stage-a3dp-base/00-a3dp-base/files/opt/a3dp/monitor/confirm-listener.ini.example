# a3dp confirm listener config — deployed to /home/pi/monitor/confirm-listener.ini (0600 pi)
# The Pi 5's ONLY printer-write path: OP5 NPU alarm -> GLM re-judges the SAME
# frame -> PAUSE sent only on GLM confirmation. Never pauses on the NPU alone.

[listener]
port = 8765
bind = 0.0.0.0
# shared bearer token (generated by install.sh: /etc/a3dp-print-monitor/confirm.token,
# 0640 root:pi here, root:orangepi on the OP5). NEVER commit the real token.
token_file = /etc/a3dp-print-monitor/confirm.token
# source allowlist: the OP5 detector + localhost only
allowed_ips = 192.168.50.20,127.0.0.1
# minimum GLM confidence to authorize a pause (the confirm judge's bar)
confirm_min_conf = 0.6
# ignore repeat confirm requests within this window (GLM queue protection);
# the NPU's x3-consecutive alert path still pages while the cooldown runs
cooldown_s = 300
pause_enabled = true
pause_verify_s = 10
frame_retention_days = 7
pause_frame_dir = /home/pi/print-monitor/pause-frames
alerts_file = /home/pi/print-monitor/alerts/unread.jsonl
verdicts_file = /home/pi/print-monitor/logs/verdicts.jsonl
# LAN base for the clickable frame link in alerts (served by this listener)
frame_url_base = http://192.168.50.123:8765
marker_file = /home/pi/print-monitor/auto_pause.json

[printer]
moonraker_url = http://192.168.50.219:7125
pause_script = PAUSE

[vlm]
endpoint = http://192.168.50.232:8080/v1/chat/completions
# same lane as the passive monitor: brain-glm = alias of glm53-qad2 = the
# always-resident a3dp-brain upstream -> no lane swap, no eviction risk
model = brain-glm
api_key_file = /etc/a3dp-print-monitor/llamaswap.key
timeout_s = 120
