<div id=flog>plan not loaded yet.</div>
<script>
async function refresh(){
  const d = await (await fetch('/api/boards')).json();
  const t = document.getElementById('t'); t.innerHTML = t.rows[0].outerHTML;
  const b = document.getElementById('b'); b.innerHTML = '';
  document.getElementById('warn').style.display = d.klipper_running ? 'block':'none';
  for (const s of d.serial){ const r=t.insertRow();
    const kat = s.kind === 'katapult';
    if (kat) r.bgColor='#1a3a1a';
    r.insertCell().textContent = s.board || '(unknown)';
    r.insertCell().textContent = s.name;
    r.insertCell().textContent = kat ? 'katapult bootloader (flashable)'
                                     : 'running Klipper CDC ' + s['vid:pid'];
    r.insertCell().textContent = (d.versions||{})[s.board] || '-';
    r.insertCell().textContent = kat ? 'select below' : 'use FLASH_MCU in Mainsail'; }
  for (const x of d.bootsel){ const r=t.insertRow(); r.bgColor='#3a1a1a';
    r.insertCell().textContent = 'BOOTSEL board';
    r.insertCell().textContent = x.block_dev;
    r.insertCell().textContent = 'RP2 bootloader (mass storage)';
    r.insertCell().textContent = '-';
    r.insertCell().textContent = 'select below'; }
  for (const x of d.bootsel){ const o=document.createElement('option');
    o.value='bootsel:'+x.block_dev; o.textContent=x.block_dev+' ('+x.usb_dev+')'; b.appendChild(o); }
  for (const s of d.serial){ if (s.kind==='katapult'){ const o=document.createElement('option');
    o.value='kat:'+s.name; o.textContent=s.name+' (katapult bootloader)'; b.appendChild(o); } }
  const f = document.getElementById('f'); f.innerHTML='';
  for (const x of d.firmware){ const o=document.createElement('option');
    o.value=x.path; o.textContent=x.file; f.appendChild(o); }
  const kats = d.serial.filter(s=>s.kind==='katapult').length;
  let note = d.firmware.length ? d.firmware.length + ' firmware file(s) in ' + d.firmware_dir
                               : 'no .uf2 files in ' + d.firmware_dir;
  if (kats && !d.katapult_tool) note += ' — WARNING: katapult flashtool not found (clone katapult / set katapult_flashtool)';
  document.getElementById('log').textContent = note;
}
async function doFlash(){
  const v = document.getElementById('b').value;
  if (!v) { log('No flashable board detected.'); return; }
  if (!confirm('Write the selected UF2 to the selected board?')) return;
  const isKat = v.startsWith('kat:');
  const body = isKat ? {kind:'katapult', target: v.slice(4), file: document.getElementById('f').value}
                     : {kind:'bootsel', block_dev: v.slice(8), file: document.getElementById('f').value};
  const r = await fetch('/api/flash', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify(body)});
  const j = await r.json(); log((j.ok?'OK: ':'FAIL: ') + j.msg); refresh();
}
function log(m){ document.getElementById('log').textContent = m; }
function logf(m){ document.getElementById('flog').textContent = m; }
async function doFullPlan(){
  const d = await (await fetch('/api/full/plan')).json();
  const t = document.getElementById('ft'); t.innerHTML = t.rows[0].outerHTML;
  logf('guard: ' + (d.guard.ok ? 'OK — ' : 'REFUSED — ') + d.guard.reason
     + ' | host build: ' + (d.host_version || '?'));
  for (const s of d.slots){ const r = t.insertRow();
    r.insertCell().textContent = s.slot;
    r.insertCell().textContent = s.status + (s.up_to_date ? ' (up to date)' : '');
    r.insertCell().textContent = s.gate + (s.gate_msg ? ': ' + s.gate_msg : '');
    r.insertCell().textContent = s.current || '-';
    r.insertCell().textContent = s.cmd ? s.cmd.join(' ') : s.reason; }
}
async function doFull(){
  if (!document.getElementById('fc').checked) { logf('Tick the confirmation box first.'); return; }
  if (!confirm('Stop Klipper and reflash every ready MCU slot now?')) return;
  const r = await fetch('/api/full/start', {method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({confirm:true, force: document.getElementById('ff').checked})});
  const j = await r.json();
  logf((j.ok ? 'STARTED: ' : 'REFUSED: ') + j.msg
     + (j.slots ? ' [' + j.slots.join(', ') + ']' : ''));
  if (j.ok) pollFull();
}
async function pollFull(){
  const d = await (await fetch('/api/full/status')).json();
  logf((d.running ? 'RUNNING' : 'DONE') + ' since ' + (d.started || '?') + '\\n'
     + (d.steps || []).map(s => s.t + '  ' + s.msg).join('\\n')
     + (d.error ? '\\nERROR: ' + d.error : ''));
  if (d.running) setTimeout(pollFull, 2000);
}
doFullPlan();
refresh(); setInterval(refresh, 15000);
</script></body></html>"""


def enumerate_payload(cfg):
    serials = label_serials(list_serial_mcus(), parse_mcus_ini(cfg["mcus_ini"]))
    ident = {}
    for name in parse_mcus_ini(cfg["mcus_ini"]):
        e = expected_byid(parse_kconfig_identity(config_file_for(name, cfg)))
        if e:
            ident[name] = e
    return {
        "bootsel": find_bootsel_volumes(),
        "serial": serials,
        "identity": ident,
        "firmware": scan_firmware_dir(cfg["firmware_dir"]),
        "firmware_dir": cfg["firmware_dir"],
        "versions": klippy_mcu_versions(cfg["klippy_log"]),
        "klipper_running": _klipper_service_active(),
        "katapult_tool": find_katapult_tool(cfg),
    }


def _klipper_service_active():
    try:
        r = subprocess.run(["systemctl", "is-active", "--quiet", "klipper"])
        return r.returncode == 0
    except OSError:
        return False


class Handler(BaseHTTPRequestHandler):
    cfg = None

    def _json(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path in ("/", "/index.html"):
            body = PAGE.encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        elif self.path == "/api/boards":
            self._json(enumerate_payload(self.cfg))
        elif self.path == "/api/full/plan":
            self._json(build_full_plan(self.cfg))
        elif self.path == "/api/full/status":
            with FULL_LOCK:
                self._json(dict(FULL_JOB))
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        if self.path == "/api/full/start":
            n = int(self.headers.get("Content-Length", 0))
            try:
                req = json.loads(self.rfile.read(n))
            except json.JSONDecodeError:
                return self._json({"ok": False, "msg": "bad json"}, 400)
            if req.get("confirm") is not True:
                return self._json({"ok": False, "msg": "confirm:true required "
                                   "— the UI confirm dialog must be accepted"})
            plan = build_full_plan(self.cfg,
                                   slots=req.get("slots") or None,
                                   allow_change=bool(req.get("allow_identity_change")))
            if not plan["guard"]["ok"]:
                return self._json({"ok": False, "refused": "print_active",
                                   "msg": plan["guard"]["reason"]})
            ready = [s for s in plan["slots"] if s["status"] == "ready"]
            if not ready:
                return self._json({"ok": False, "msg": "no flashable slots in "
                                   "the plan (see /api/full/plan for reasons)"})
            started = start_full_job(self.cfg, ready,
                                     force=bool(req.get("force")),
                                     skip_build=bool(req.get("skip_build")))
            return self._json({"ok": started,
                               "msg": "full update started" if started
                               else "a full update is already running",
                               "slots": [s["slot"] for s in ready]})
        if self.path != "/api/flash":
            return self._json({"error": "not found"}, 404)
        n = int(self.headers.get("Content-Length", 0))
        try:
            req = json.loads(self.rfile.read(n))
        except json.JSONDecodeError:
            return self._json({"ok": False, "msg": "bad json"}, 400)
        uf2 = req.get("file")
        if not os.path.isfile(uf2):
            # allow a bare filename resolved inside firmware_dir
            alt = os.path.join(self.cfg["firmware_dir"], os.path.basename(str(uf2)))
            if os.path.isfile(alt):
                uf2 = alt
            else:
                return self._json({"ok": False, "msg": f"firmware file not found: {uf2}"})
        before = list_serial_mcus()
        allow = bool(req.get("allow_identity_change"))
        board = req.get("board") or ""
        status, gmsg = identity_gate(board, self.cfg, before, allow)
        if status == "refuse":
            return self._json({"ok": False, "msg": gmsg, "refused": "identity"})
        ident = parse_kconfig_identity(config_file_for(board, self.cfg))
        expected = expected_byid(ident)
        if req.get("kind") == "katapult":
            target = req.get("target") or ""
            kat = {s["name"] for s in list_serial_mcus() if s["kind"] == "katapult"}
            if target not in kat:
                return self._json({"ok": False,
                                   "msg": f"{target} is not a katapult-bootloader board right now"})
            ok, msg = flash_katapult(uf2, os.path.join("/dev/serial/by-id", target),
                                     find_katapult_tool(self.cfg))
        else:
            block_dev = req.get("block_dev")
            bootsel = {b["block_dev"] for b in find_bootsel_volumes()}
            if block_dev not in bootsel:
                return self._json({"ok": False,
                                   "msg": f"{block_dev} is not a BOOTSEL-mode board right now"})
            ok, msg = flash_boot(uf2, block_dev)
        if ok:
            new = wait_reenumerate(before)
            msg += f"; re-enumeration: {new or 'not seen yet (check dmesg)'}"
            check = check_post_flash_identity(new, expected)
            if check:
                msg += f"; {check}"
                if "MISMATCH" in check:
                    ok = False
        self._json({"ok": ok, "msg": msg})

    def log_message(self, fmt, *args):
        sys.stderr.write("[mcu-flashd] " + fmt % args + "\n")


def serve(cfg):
    Handler.cfg = cfg
    httpd = ThreadingHTTPServer((cfg["listen"], cfg["port"]), Handler)
    print(f"a3dp-mcu-flashd serving http://{cfg['listen']}:{cfg['port']} "
          f"(firmware_dir={cfg['firmware_dir']})", flush=True)
    httpd.serve_forever()


# --------------------------------------------------------------------- cli

def cmd_enumerate(cfg, as_json):
    payload = enumerate_payload(cfg)
    if as_json:
        print(json.dumps(payload, indent=2))
        return 0
    for s in payload["serial"]:
        print(f"{s.get('kind', 'other'):7s}  {s['name']}  tty={s['tty']}"
              f"  vid:pid={s['vid:pid']}"
              + (f"  board={s['board']}" if s["board"] else ""))
    for b in payload["bootsel"]:
        print(f"BOOTSEL {b['usb_dev']}  {b['block_dev']}  ({b['label']}) — flashable")
    kats = [s for s in payload["serial"] if s.get("kind") == "katapult"]
    if kats:
        print("katapult flashtool: "
              + (payload.get("katapult_tool")
                 or "NOT FOUND (clone katapult / set katapult_flashtool)"))
    if not payload["serial"] and not payload["bootsel"]:
        print("no MCU boards found")
    print(f"firmware dir: {payload['firmware_dir']} "
          f"({len(payload['firmware'])} .uf2 file(s))")
    return 0


def cmd_flash(cfg, target, uf2, allow_change=False, board_hint=None):
    kind, obj = resolve_target(target, cfg)
    if kind is None:
        print(f"target '{target}' not found — run enumerate. A board must be in "
              "BOOTSEL mode (hold BOOTSEL while plugging USB) for the "
              "Klipper-independent path.", file=sys.stderr)
        return 2
    if kind == "serial":
        print(f"'{target}' is a running Klipper board ({obj['name']}) — the "
              "Klipper-independent path only flashes BOOTSEL or katapult-"
              "bootloader boards. Use the FLASH_MCU macro / moonraker-mcu-"
              "flasher while klipper works, or hold BOOTSEL (or enter katapult) "
              "and re-run.", file=sys.stderr)
        return 3
    board = board_hint or (obj.get("board") if obj else None)
    status, gmsg = identity_gate(board, cfg, list_serial_mcus(), allow_change)
    print(f"identity: {gmsg}")
    if status == "refuse":
        return 5
    ident = parse_kconfig_identity(config_file_for(board, cfg))
    expected = expected_byid(ident)
    before = list_serial_mcus()
    if kind == "katapult":
        ok, msg = flash_katapult(uf2, os.path.join("/dev/serial/by-id", obj["name"]),
                                 find_katapult_tool(cfg))
        print(msg)
        if not ok:
            return 1
        new = wait_reenumerate(before)
        print(f"re-enumeration: {new or 'not seen within 25s — check dmesg / replug'}")
        check = check_post_flash_identity(new, expected)
        if check:
            print(check)
            if "MISMATCH" in check:
                return 6
        return 0
    ok, msg = flash_boot(uf2, obj["block_dev"])
    print(msg)
    if not ok:
        return 1
    new = wait_reenumerate(before)
    print(f"re-enumeration: {new or 'not seen within 25s — check dmesg / replug'}")
    check = check_post_flash_identity(new, expected)
    if check:
        print(check)
        if "MISMATCH" in check:
            return 6
    return 0


def cmd_full(cfg, plan_only=False, slots=None, allow_change=False,
             force=False, skip_build=False, yes=False):
    """Full update: build every slot from its config.<slot> at the host build
    and flash it (identity gate + print guard). --plan prints and exits."""
    slots = [s.strip() for s in slots.split(",")] if slots else None
    plan = build_full_plan(cfg, slots=slots, allow_change=allow_change)
    g = plan["guard"]
    print(f"guard: {'OK' if g['ok'] else 'REFUSED'} — {g['reason']}")
    print(f"host build: {plan['host_version'] or '?'}   "
          f"MCU versions: {plan['mcu_versions'] or '{}'}")
    ready = []
    for s in plan["slots"]:
        tag = s["status"] + (" (up to date)" if s.get("up_to_date") else "")
        print(f"[{s['slot']}] {tag}  gate={s['gate']}")
        if s["status"] == "ready":
            print(f"    cmd: {' '.join(s['cmd'])}")
            ready.append(s)
        else:
            print(f"    skip: {s['reason']}")
    if plan_only or not yes:
        if not plan_only:
            print("dry plan only — pass --yes to execute, --plan to silence "
                  "this hint")
        return 0
    if not g["ok"]:
        print("guard refused — nothing flashed", file=sys.stderr)
        return 7
    if not ready:
        print("no flashable slots — nothing to do")
        return 0
    summary = execute_full(cfg, ready, force=force, skip_build=skip_build)
    ok = summary["ok"] and all(r["ok"] for r in summary["results"])
    print("full update:", "OK" if ok else "COMPLETED WITH FAILURES")
    return 0 if ok else 1


def cmd_verify(cfg, target, by_id_dir="/dev/serial/by-id", sysfs="/sys"):
    """Post-swap check: a board's live by-id name vs its config.mcu identity."""
    kind, obj = resolve_target(target, cfg, sysfs=sysfs, by_id_dir=by_id_dir)
    if kind is None:
        print(f"target '{target}' not found — run enumerate", file=sys.stderr)
        return 2
    if kind == "bootsel":
        print("BOOTSEL board carries no identity until flashed — flash first, "
              "then verify", file=sys.stderr)
        return 2
    board = obj.get("board")
    if not board and os.path.isfile(config_file_for(target, cfg) or ""):
        # no mcus.ini label — but a config.<target> exists: the target IS the
        # slot name (deterministic-serial boards, Rift 2026-11-13)
        board = target
    ident = parse_kconfig_identity(config_file_for(board, cfg))
    if ident is None:
        print(f"no config.mcu for board '{board}' — nothing to verify against")
        return 3
    if ident["chipid"]:
        print(f"chip-id identity (config.mcu): {obj['name']} "
              f"(serial {obj['chipid']}) — not deterministic; record this "
              "chip-id for the replacement procedure")
        return 0
    expected = expected_byid(ident)
    if obj["name"] == expected:
        print(f"OK: {obj['name']} matches config.mcu identity")
        return 0
    print(f"MISMATCH: board reports {obj['name']}, config.mcu expects {expected}",
          file=sys.stderr)
    return 4


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--cfg", default="/etc/a3dp-mcu-flashd.ini",
                        help="service ini (default /etc/a3dp-mcu-flashd.ini)")
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0],
                                 parents=[common])
    sub = ap.add_subparsers(dest="cmd", required=True)
    # --cfg accepted before AND after the subcommand (systemd unit uses the latter)
    sub.add_parser("enumerate", parents=[common]).add_argument(
        "--json", action="store_true")
    p = sub.add_parser("flash", parents=[common])
    p.add_argument("target", help="board name (mcus.ini), chipid or block dev")
    p.add_argument("uf2", help="firmware .uf2 file")
    p.add_argument("--board", help="board slot name (mcus.ini section) for the "
                   "config.mcu identity gate, when the target is a BOOTSEL board")
    p.add_argument("--allow-identity-change", action="store_true",
                   help="flash even when config.mcu's identity conflicts with "
                   "the live board (deliberate rename — update printer.cfg "
                   "+ mcus.ini afterwards)")
    sub.add_parser("verify", parents=[common]).add_argument(
        "target", help="board name (mcus.ini), chipid or by-id fragment")
    p = sub.add_parser("full", parents=[common],
                       help="full update: build+flash every mcus.ini slot at "
                            "the host build (identity-gated, print-guarded)")
    p.add_argument("--plan", action="store_true",
                   help="print the plan and exit — no changes")
    p.add_argument("--slots", help="comma-separated mcus.ini sections "
                   "(default: all)")
    p.add_argument("--allow-identity-change", action="store_true",
                   help="flash slots whose config.mcu identity conflicts with "
                   "the live board (deliberate rename); also lets a slot whose "
                   "expected name is not yet enumerated (board still on stock "
                   "firmware) flash through the board's current live by-id — "
                   "the identity is assigned by the firmware and verified "
                   "post-flash")
    p.add_argument("--force", action="store_true",
                   help="reflash even when firmware matches the host build")
    p.add_argument("--skip-build", action="store_true",
                   help="flash without rebuilding (uses the last build)")
    p.add_argument("--yes", action="store_true",
                   help="execute without the plan prompt")
    sub.add_parser("serve", parents=[common]).add_argument("--port", type=int)
    args = ap.parse_args()
    cfg = load_cfg(args.cfg)
    if args.cmd == "enumerate":
        sys.exit(cmd_enumerate(cfg, args.json))
    if args.cmd == "flash":
        sys.exit(cmd_flash(cfg, args.target, args.uf2,
                           allow_change=args.allow_identity_change,
                           board_hint=args.board))
    if args.cmd == "verify":
        sys.exit(cmd_verify(cfg, args.target))
    if args.cmd == "full":
        sys.exit(cmd_full(cfg, plan_only=args.plan, slots=args.slots,
                          allow_change=args.allow_identity_change,
                          force=args.force, skip_build=args.skip_build,
                          yes=args.yes))
    if args.port:
        cfg["port"] = args.port
    serve(cfg)


if __name__ == "__main__":
    main()
